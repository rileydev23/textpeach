<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit">
  <!-- Design tokens: see docs/DISENO.md for the full system. -->
  <Styles.Resources>
    <x:Double x:Key="TreeViewItemMinHeight">22</x:Double>
    <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="#2d2e33" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundPressed" Color="#2d2e33" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#33507a" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#3a5a88" />
    <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#33507a" />
    <SolidColorBrush x:Key="TreeViewItemForegroundPointerOver" Color="#d4d4d4" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#ffffff" />
    <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#ffffff" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#33507a" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3a5a88" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#33507a" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="#1e1f22" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="#2d2e33" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderBrush" Value="#3a3c42" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3a3c42" />
  </Style>
  <!-- "Proyectos" launcher in the tab strip: darker, square, separated from the tabs. -->
  <Style Selector="Button.home">
    <Setter Property="Background" Value="#111214" />
    <Setter Property="Foreground" Value="#a8abb2" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderBrush" Value="#3a3c42" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.home:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1f2024" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.home.active">
    <Setter Property="Background" Value="#0d1520" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="#4a90d9" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#5aa0e9" />
  </Style>
  <!-- Edit mode: the only "warning" button, so editing never looks like the default action. -->
  <Style Selector="Button.warn">
    <Setter Property="Background" Value="#5a4318" />
    <Setter Property="BorderBrush" Value="#8a6d1f" />
  </Style>
  <Style Selector="Button.warn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#6e5320" />
  </Style>

  <!-- Segmented switch (sidebar Archivos / Buscar): active segment gets an accent underline. -->
  <Style Selector="Button.seg">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="#8a8d93" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="6,6" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.seg.active">
    <Setter Property="BorderBrush" Value="#4a90d9" />
    <Setter Property="Foreground" Value="#ffffff" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Two-state view switch in a header (Renderizada | Código): joined buttons, active one in selection blue. -->
  <Style Selector="Button.mode">
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#8a8d93" />
  </Style>
  <Style Selector="Button.mode.left">
    <Setter Property="CornerRadius" Value="3,0,0,3" />
  </Style>
  <Style Selector="Button.mode.right">
    <Setter Property="CornerRadius" Value="0,3,3,0" />
    <Setter Property="BorderThickness" Value="0,1,1,1" />
  </Style>
  <Style Selector="Button.mode.active">
    <Setter Property="Background" Value="#33507a" />
    <Setter Property="Foreground" Value="#ffffff" />
  </Style>
  <Style Selector="Button.mode.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#3a5a88" />
  </Style>

  <Style Selector="ToggleButton">
    <Setter Property="Background" Value="#2d2e33" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderBrush" Value="#3a3c42" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ToggleButton.chip">
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="#26272b" />
    <Setter Property="BorderBrush" Value="#3a3c42" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33507a" />
  </Style>
  <Style Selector="ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2d2e33" />
  </Style>

  <!-- File tab strip inside a project: selected tab blends into the header below it. -->
  <Style Selector="ListBox.doctabs ListBoxItem">
    <Setter Property="BorderBrush" Value="#3a3c42" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="ListBox.doctabs ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#26272b" />
  </Style>
  <Style Selector="ListBox.doctabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="TreeView">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
    <Setter Property="Margin" Value="6,0,4,0" />
  </Style>

  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="#3a3c42" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="#8a8d93" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Code viewer -->
  <Style Selector="ae|TextEditor">
    <Setter Property="Background" Value="#1b1c1f" />
    <Setter Property="Foreground" Value="#d4d4d4" />
    <Setter Property="LineNumbersForeground" Value="#5d6066" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
  </Style>
</Styles>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TextPeach.ViewModels"
             x:Class="TextPeach.Views.SummaryView"
             x:DataType="vm:SummaryViewModel"
             Background="#1e1f22">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,18,24,24" Spacing="18" MaxWidth="1100" HorizontalAlignment="Stretch">
      <!-- Header -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsBusy}">
          <TextBlock Classes="dim" Text="{Binding BusyText}" VerticalAlignment="Center" />
          <ProgressBar IsIndeterminate="True" Width="90" Height="4" />
        </StackPanel>
        <StackPanel Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Resumen del proyecto" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding KindText}" Foreground="#6cc070" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{Binding RootPath}" Classes="dim mono" FontSize="12" />
        </StackPanel>
      </DockPanel>

      <!-- Stat tiles -->
      <ItemsControl ItemsSource="{Binding Tiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:StatTile">
            <Border Background="#26272b" BorderBrush="#3a3c42" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,10,10" MinWidth="150">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Label}" Classes="dim" FontSize="11" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Languages -->
      <Border Background="#222327" BorderBrush="#3a3c42" BorderThickness="1" CornerRadius="4" Padding="14,10">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Lenguajes (por líneas)" />
          <ItemsControl ItemsSource="{Binding Languages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LangStatVM">
                <Grid ColumnDefinitions="150,230,70,90,*" Margin="0,3">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="●" Foreground="{Binding Brush}" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{Binding Brush}" Width="{Binding BarWidth}" Height="8" CornerRadius="0,4,4,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding ShareText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding LinesText}" Classes="dim" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding FilesText}" Classes="dim" Margin="16,0,0,0" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Largest files + markers -->
      <Grid ColumnDefinitions="*,16,*">
        <Border Background="#222327" BorderBrush="#3a3c42" BorderThickness="1" CornerRadius="4" Padding="0,10,0,6" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="Archivos más extensos" Margin="14,0" />
            <ListBox x:Name="BigList" ItemsSource="{Binding Largest}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BigFileVM">
                  <DockPanel Margin="14,3" ToolTip.Tip="{Binding RelPath}">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Classes="dim" FontSize="11" MinWidth="64" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LinesText}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Left" Text="●" Foreground="{Binding GlyphBrush}" FontSize="9" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding RelPath}" FontSize="12" TextTrimming="LeadingCharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#222327" BorderBrush="#3a3c42" BorderThickness="1" CornerRadius="4" Padding="0,10,0,6" VerticalAlignment="Top">
          <StackPanel Spacing="6">
            <TextBlock Classes="section" Text="{Binding MarkersHeader}" Margin="14,0" />
            <TextBlock Classes="dim" FontSize="12" Text="Sin TODO / FIXME / HACK en el proyecto" Margin="14,0" IsVisible="{Binding !Markers.Count}" />
            <ListBox x:Name="MarkerList" ItemsSource="{Binding Markers}" MaxHeight="420">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:MarkerRowVM">
                  <StackPanel Margin="14,3" ToolTip.Tip="{Binding Location}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Tag}" Foreground="{Binding TagBrush}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding Location}" Classes="dim" FontSize="11" TextTrimming="LeadingCharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
